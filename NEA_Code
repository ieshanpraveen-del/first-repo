def Optimiser():  # OPTIMISER CODE(VERY IMPORTANT)
    optimiser_screen = Tk()
    optimiser_screen.title("Optimiser")
    optimiser_screen.geometry('250x250')

    def show_list():
        playerlist = Tk()
        playerlist.title("Player List")
        path =("C:/Users/iesha/fantasy_lineups.xlsx")
        workbook = openpyxl.load_workbook(path)
        sheet = workbook.active

        list_values = list(sheet.values)
        cols = list_values[0]
        tree = ttk.Treeview(playerlist, columns= cols, show = "headings")

        scrollbar = ttk.Scrollbar(playerlist, orient="horizontal", command=tree.xview)
        tree.configure(xscrollcommand=scrollbar.set)
        scrollbar.pack(fill='x')

        for col_name in cols:
            tree.heading(col_name, text = col_name)
        tree.pack(expand = True, fill = 'y')
        for value_tuple in list_values[1:]:
            tree.insert('', END, values = value_tuple)

    def run_optimiser():

        players = pd.read_csv("C:/Users/iesha/OneDrive/Desktop/NEA/basketball_players_with_ID.csv") # import csv file
        usecols = ['PlayerID','Name', 'Position', 'FantasyPPG'] # columns to use

        # Create workbook for output in Excel
        wb = openpyxl.Workbook()
        ws = wb.active

        # Add headers to Excel spreadsheet
        headers = ['PG1', 'PG2', 'SG1', 'SG2', 'SF1', 'SF2', 'PF1', 'PF2', 'C', 'Total Points']
        for col, header in enumerate(headers, 1):
            ws.cell(row=1, column=col).value = header
            ws.cell(row=1, column=col).font = openpyxl.styles.Font(bold=True)

        # Group the players by the position
        availables = players.groupby(['Position', 'PlayerID', 'FantasyPPG', 'Name']).size().reset_index(name='count')

        # Initialize points dictionary for each position
        points = {}
        for pos in availables.Position.unique():
            availables_pos = availables[availables.Position == pos]
            pos_points = dict(zip(availables_pos['PlayerID'], availables_pos['FantasyPPG']))
            points[pos] = pos_points

        # Position requirements for lineup
        pos_num_available = {
            "PG": 2,  # Point Guards
            "SG": 2,  # Shooting Guards
            "SF": 2,  # Small Forwards
            "PF": 2,  # Power Forwards
            "C": 1   # Centers
        }

        # Generate multiple lineups
        previous_lineups = []  # Store previous lineups so they won't duplicate

        for lineup in range(1, 10):
            # Create binary variables for each player in each position
            _vars = {k: LpVariable.dicts(k, v.keys(), cat='Binary') for k, v in points.items()}

            # Create the optimization problem
            prob = LpProblem(f"Fantasy_Lineup_{lineup}", LpMaximize)
    
            # Objective function: maximize total fantasy points
            total_points = []
            for pos, players_dict in points.items():
                for player_id, player_points in players_dict.items():
                    total_points.append(player_points * _vars[pos][player_id])

            prob += lpSum(total_points)

            # Position constraints: exactly the required number of players per position
            for pos in points.keys():
                prob += lpSum([_vars[pos][player_id] for player_id in points[pos]]) == pos_num_available[pos]
            # Don't count lineups we've already found (exclude previous lineups)
            for prev_lineup in previous_lineups:
                prob += lpSum([_vars[pos][player_id] for pos, player_id in prev_lineup]) <= len(prev_lineup) - 1

            # Solve the problem
            prob.solve()

            # Check if solution was found
            if prob.status != 1:
                print(f"No optimal solution found for lineup {lineup}")
                break

            # Extract the selected players and calculate total score
            selected_players = []
            total_score = 0

            # Dictionary to organize players by position with counts
            lineup_players = {'PG': [], 'SG': [], 'SF': [], 'PF': [], 'C': []}

            for pos in points.keys():
                for player_id in points[pos]:
                    if _vars[pos][player_id].varValue == 1:
                        # Find player name
                        player_name = availables[(availables.PlayerID == player_id) &
                                               (availables.Position == pos)]['Name'].iloc[0]
                        player_points = points[pos][player_id]
                
                        # Add to position list
                        lineup_players[pos].append(f"{player_name} ({player_points:.1f})")
                
                        # Constraint track
                        selected_players.append((pos, player_id))
                        total_score += player_points

            # Write to Excel in correct column order
            row = lineup + 1
            col = 1

            # Fill in each position one at a time
            for pos in ['PG', 'SG', 'SF', 'PF', 'C']:
                players_in_pos = lineup_players[pos]
                for i in range(pos_num_available[pos]):
                    if i < len(players_in_pos):
                        ws.cell(row=row, column=col).value = players_in_pos[i]
                    col += 1

            # Add total score
            ws.cell(row=row, column=col).value = round(total_score, 2)

            # Cache this lineup to skip in subsequent iterations
            previous_lineups.append(selected_players)
    
            print(f"Lineup {lineup}: Total Fantasy Points = {total_score:.2f}")
            print(f"PG: {lineup_players['PG']}")
            print(f"SG: {lineup_players['SG']}")
            print(f"SF: {lineup_players['SF']}")
            print(f"PF: {lineup_players['PF']}")
            print(f"C: {lineup_players['C']}")
            print("-" * 50)

        # Save the Excel file
        wb.save("fantasy_lineups.xlsx")
        show_list()


    optimiser_button = Button(optimiser_screen, text = "Run optimiser", command = run_optimiser)

    optimiser_button.grid(row = 0, column = 0)



